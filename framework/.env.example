# OpenAI-compatible chat model endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL=replace_with_your_model_id
LLM_REQUEST_TIMEOUT=300

# Embedding endpoint. config.py otherwise falls back to the chat endpoint.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace_with_your_embedding_api_key
EMBEDDING_MODEL=text-embedding-ada-002

# PostgreSQL/PostGIS database restored from ../create_database.sql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=NL2SQL
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password

# Execution and retrieval limits used by the released framework
SANDBOX_TIMEOUT=60
SANDBOX_OOM_MAX_FILE_MB=1024
SQL_STATEMENT_TIMEOUT_MS=30000
SQL_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
SQL_MAX_RESULT_ROWS=100000
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_TOOL=8
RAG_PLANNER_MAX_TABLES=4
RAG_FK_MAX_TOTAL_TABLES=16
RAG_FK_MAX_DEPTH=3
RECURSION_LIMIT=48
TEXT2SQL_CONSECUTIVE_FAILURE_LIMIT=3
V2_MAX_EVIDENCE_REVIEWS=1
V2_MAX_REPLANS=1
